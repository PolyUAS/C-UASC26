<mujoco model="drone">
  <!-- Minimal MJCF quadrotor model for mujoco-sim.
       Used when mujoco-sys is wired for real physics.
       For stub mode (no mujoco-sys calls in step()), this file is loaded
       but not stepped through MuJoCo. -->

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="drone" pos="0 0 0.1">
      <!-- Free joint gives 7 qpos [x,y,z, qw,qx,qy,qz] and 6 qvel [vx,vy,vz, wx,wy,wz] -->
      <freejoint name="root"/>
      <geom type="box" size="0.2 0.2 0.05" mass="1.5" rgba="0.2 0.2 0.8 1"/>

      <!-- Four motor thrust sites (Z-up in world frame) -->
      <site name="rotor_fr" pos=" 0.15  0.15 0.05" type="sphere" size="0.02"/>
      <site name="rotor_fl" pos="-0.15  0.15 0.05" type="sphere" size="0.02"/>
      <site name="rotor_br" pos=" 0.15 -0.15 0.05" type="sphere" size="0.02"/>
      <site name="rotor_bl" pos="-0.15 -0.15 0.05" type="sphere" size="0.02"/>

      <site name="imu" pos="0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <general name="thrust_fr" site="rotor_fr" gear="0 0 1 0 0 0" ctrlrange="0 8" ctrllimited="true"/>
    <general name="thrust_fl" site="rotor_fl" gear="0 0 1 0 0 0" ctrlrange="0 8" ctrllimited="true"/>
    <general name="thrust_br" site="rotor_br" gear="0 0 1 0 0 0" ctrlrange="0 8" ctrllimited="true"/>
    <general name="thrust_bl" site="rotor_bl" gear="0 0 1 0 0 0" ctrlrange="0 8" ctrllimited="true"/>
  </actuator>

  <sensor>
    <framepos    name="pos"  objtype="body" objname="drone"/>
    <framequat   name="quat" objtype="body" objname="drone"/>
    <framelinvel name="vel"  objtype="body" objname="drone"/>
    <gyro        name="gyro" site="imu"/>
  </sensor>
</mujoco>
