

table Detection {
    ctr_x: uint16;
    ctr_y : uint16;
    width : uint16;
    height : uint16;
    class_id: string;
    metadata: string;
    confidence : float64;
}


table Frame {
    width : uint16;
    height : uint16;
    detections : [Detection];
    metadata: string;
}


root_type Frame;
