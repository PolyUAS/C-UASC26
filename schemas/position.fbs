namespace Position;



// NOTE TO CONTROL SYSTEMS DEVELOPERS: vz IS **POSITIVE DOWN** FROM MAVLINK.
// IT IS INVERTED IN THE CONTROL NODE to **POSITIVE UP**
table GlobalPositionInt {
    lat: int32; // degE7
    lon: int32; // degE7
    alt: int32; // mm above sea level
    vx: int16; //cm/sec North
    vy: int16; //cm/sec East
    vz: int16; // cm/sec POSITIVE UP
    heading: uint16; // degE2 [00 -> 35999]
    alt_above_home: int32; // mm above home
}


root_type GlobalPositionInt;
