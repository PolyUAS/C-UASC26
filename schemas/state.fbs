namespace MavlinkFB;

struct StateVector {
  time_usec: uint64;
  quaternion: [float32:4];
  rollspeed: float;
  pitchspeed: float;
  yawspeed: float;

  pos: [int32:3];
  vel: [int16:3];
  acc: [int16:3];


  ind_airspeed: uint16;
  true_airspeed: uint16;
}


struct Attitude {
    time_boot_ms: uint32;
    roll: float32;
    pitch: float32;
    yaw: float32;
    angular_velos: [float32:3];
}

struct GlobalPosition {
    time_boot_ms: uint32;
    lat: int32;
    lon: int32;
    alt: int32;
    above_home_alt: int32;
    velocites: [int16:3];
    heading_yaw: uint16;
}

// no root type
