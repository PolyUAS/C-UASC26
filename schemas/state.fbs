namespace MavlinkFB;

// ────────────────────────────────────────────────
// Fixed-size vector types as structs (required!)
struct FloatVec3 {
    x: float;
    y: float;
    z: float;
}

struct Int32Vec3 {
    x: int32;
    y: int32;
    z: int32;
}

struct Int16Vec3 {
    x: int16;
    y: int16;
    z: int16;
}

struct Quaternion {
    w: float32;
    x: float32;
    y: float32;
    z: float32;
}

// ────────────────────────────────────────────────
// Reusable attitude block (matches your struct)
struct Attitude {
    time_boot_ms:   uint32;
    roll:           float32;
    pitch:          float32;
    yaw:            float32;
    angular_velos:  FloatVec3;     // was [float32:3]
}



// ────────────────────────────────────────────────
// Main compact state vector for logging / telemetry / fusion
table StateVector {
    time_usec:          uint64;

    quaternion:         Quaternion;

    rollspeed:          float;
    pitchspeed:         float;
    yawspeed:           float;

    pos:                Int32Vec3;
    vel:                Int16Vec3;
    acc:                Int16Vec3;

    ind_airspeed:       uint16;
    true_airspeed:      uint16;
}

root_type StateVector;
