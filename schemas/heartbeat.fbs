include "attitude.fbs";

namespace Heartbeat;



enum Status : byte {
    Active = 0,
    Boot,
    Calibrating,
    Standby,
    Critical,
    Emergency,
    Flight_Terminating,
    Power_Off,
    Uninit
}


table HeartbeatHealthPacket {
    system_status:Status;
    guided:bool;
    auto:bool;
    manual:bool;
    armed:bool;
}


root_type HeartbeatHealthPacket;
