// SupervisorSignal — published on guidance/supervisor/signal
// Producer: navigation watchdog, geofence breach handler
// Consumer: guidance-bridge gate

namespace guidance;

enum SupervisorState: byte {
  NOMINAL = 0,
  DEGRADED,
  CRITICAL,
  FAILSAFE
}

enum SupervisorAction: byte {
  CONTINUE = 0,
  HOLD,
  RTL,
  ABORT
}

table SupervisorSignal {
  timestamp_ms:  uint64;
  state:         SupervisorState;
  action:        SupervisorAction;
  reason:        string;
}

root_type SupervisorSignal;
