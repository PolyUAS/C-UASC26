// MissionCommand — published on guidance/mission/command
// Producer: mission FSMs via guidance-bridge, CLI tools
// Consumer: control (hardware dispatch) OR mujoco-sim (sim actuation)

namespace guidance;

enum CommandType: byte {
  ARM = 0,
  TAKEOFF,
  GOTO,
  HOLD,
  RTL,
  LAND,
  PAYLOAD_RELEASE,
  PAYLOAD_SECURE,
  CAMERA_POINT,
  CAMERA_TRACK,
  MISSION_ABORT
}

table MissionCommand {
  command_id:      string (required);
  mission_id:      string (required);
  command_type:    CommandType;
  target_lat_deg:  float64;
  target_lon_deg:  float64;
  target_alt_m:    float32;
  timeout_sec:     float32 = 2.0;
  safety_mode:     string;
}

root_type MissionCommand;
